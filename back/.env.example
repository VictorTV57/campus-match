# Prisma / SQLite — path is relative to the prisma/ directory
DATABASE_URL="file:./dev.db"

# JWT — générer une valeur distincte pour chacun :
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_ACCESS_SECRET=""
JWT_REFRESH_SECRET=""
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="7d"

# Port du serveur NestJS. Le proxy Vite (front/vite.config.ts) pointe sur 3000 :
# le changer ici impose de le changer là-bas aussi.
PORT=3000
